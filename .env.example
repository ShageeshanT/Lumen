# Copy to .env for local development. These values are safe only for a local
# database started by docker-compose.dev.yml; the self-host installer generates
# real secrets (Phase 11).
PG_PORT=5432
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info
