# Copy to .env for local development. These values are safe only for a local
# database started by docker-compose.dev.yml; the self-host installer generates
# real secrets (Phase 11).
PG_PORT=5432
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# Instance-admin bearer token for the server routes until Phase 04 adds
# sessions and RBAC (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LUMEN_ADMIN_TOKEN=

# The URL servers use to reach this control plane (join commands, downloads).
# Servers only accept https:// (loopback http is allowed for local testing).
# PUBLIC_URL=https://cp.example.com

# Base64 Ed25519 seed that signs control plane → agent messages. Required in
# production; development generates one into STATE_DIR/agent-signing.key.
# AGENT_SIGNING_KEY=

# Agent releases served at /agent/download and by the installer:
# <AGENT_RELEASE_DIR>/<version>/lumen-agent-linux-<arch>{,.sha256,.minisig}
# AGENT_RELEASE_DIR=
# AGENT_LATEST_VERSION=
# AGENT_RELEASE_PUBKEY=

# Serve HTTPS directly (the self-host install puts Caddy in front instead).
# TLS_CERT_FILE=
# TLS_KEY_FILE=
