{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "gen": {
      "outputs": ["gen/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "bin/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["DATABASE_URL"],
      "outputs": ["coverage/**"]
    }
  }
}
